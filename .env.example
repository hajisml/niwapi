# Local Postgres+PostGIS (docker compose up -d db). Also accepts a real Supabase
# Postgres connection string with no code changes.
DATABASE_URL=postgresql://niwapi:niwapi@localhost:5432/niwapi

# Optional. Leave blank to store report photos on local disk under backend/media
# and serve them at /media. Set both to switch to Supabase Storage automatically.
SUPABASE_URL=
SUPABASE_KEY=

# Optional. Leave blank to use the deterministic mock blockage classifier. Set to
# call Gemini Vision for real image classification.
GEMINI_API_KEY=
